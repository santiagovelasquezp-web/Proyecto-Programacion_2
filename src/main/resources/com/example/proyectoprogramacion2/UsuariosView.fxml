<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="600.0" prefWidth="680.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.proyectoprogramacion2.Controllers.UsuariosViewController">

<children>

    <Label layoutX="30.0" layoutY="20.0" style="-fx-font-size: 28px;                       -fx-font-weight: bold;" text="Gestión de Usuarios" />
    <TextField fx:id="txtNombre" layoutX="30.0" layoutY="60.0" prefWidth="150.0" promptText="Nombre" />

    <TextField fx:id="txtCorreo" layoutX="200.0" layoutY="60.0" prefWidth="180.0" promptText="Correo" />

    <TextField fx:id="txtPassword" layoutX="400.0" layoutY="60.0" prefWidth="120.0" promptText="Contraseña" />

    <Button layoutX="30.0" layoutY="100.0" onAction="#crearUsuario" text="Crear" />

    <Button layoutX="110.0" layoutY="100.0" onAction="#eliminarUsuario" text="Eliminar" />
    <TableView fx:id="tablaUsuarios" layoutX="30.0" layoutY="120" prefHeight="420.0" prefWidth="620.0">

        <columns>

            <TableColumn fx:id="colId" prefWidth="100.0" text="ID" />

            <TableColumn fx:id="colNombre" prefWidth="180.0" text="Nombre" />

            <TableColumn fx:id="colTelefono" prefWidth="120.0" text="Telefono" />

            <TableColumn fx:id="colCorreo" prefWidth="220.0" text="Correo" />

        </columns>

    </TableView>
      <TextField fx:id="txtTelefono" layoutX="530.0" layoutY="60.0" prefWidth="120.0" promptText="Telefono" />

</children>

</AnchorPane>
