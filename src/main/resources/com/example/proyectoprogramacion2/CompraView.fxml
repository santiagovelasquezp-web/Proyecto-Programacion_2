<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="600.0" prefWidth="800.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.proyectoprogramacion2.Controllers.CompraViewController">

    <children>

        <Label layoutX="30.0"
               layoutY="20.0"
               text="Compra de Entrada"
               style="-fx-font-size: 28px; -fx-font-weight: bold;" />

        <Label layoutX="40.0"
               layoutY="100.0"
               text="Seleccionar Zona:" />

        <ComboBox fx:id="comboZona"
                  layoutX="200.0"
                  layoutY="95.0"
                  prefWidth="200.0"/>
        <Label layoutX="40.0"
               layoutY="140.0"
               text="Seleccionar Asiento:" />

        <ComboBox fx:id="comboAsiento"
                  layoutX="200.0"
                  layoutY="135.0"
                  prefWidth="200.0"/>

        <Label layoutX="40.0"
               layoutY="200.0"
               text="Seleccionar Método de Pago:" />

        <ComboBox fx:id="comboMetodoPago"
                  layoutX="260.0"
                  layoutY="200.0"
                  prefWidth="200.0"/>

        <Label layoutX="40.0"
               layoutY="250.0"
               text="Servicios Adicionales:"
               style="-fx-font-weight: bold;" />

        <CheckBox fx:id="checkVip"
                  layoutX="60.0"
                  layoutY="300.0"
                  text="Experiencia VIP (+50000)" />

        <CheckBox fx:id="checkSeguro"
                  layoutX="60.0"
                  layoutY="340.0"
                  text="Seguro del evento (+20000)" />

        <CheckBox fx:id="checkBebida"
                  layoutX="60.0"
                  layoutY="380.0"
                  text="Combo bebida (+15000)" />

        <CheckBox fx:id="checkParqueadero"
                  layoutX="60.0"
                  layoutY="420.0"
                  text="Parqueadero VIP (+30000)" />

        <Button layoutX="280.0"
                layoutY="500.0"
                prefWidth="200.0"
                text="Confirmar Compra"
                onAction="#confirmarCompra"/>

    </children>

</AnchorPane>
