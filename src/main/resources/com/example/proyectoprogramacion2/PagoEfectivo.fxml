<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="400.0"
            prefWidth="500.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.proyectoprogramacion2.Controllers.PagoEfectivoController">

    <children>

        <Label layoutX="120.0"
               layoutY="30.0"
               text="Pago en Efectivo"
               style="-fx-font-size: 28px;
                      -fx-font-weight: bold;" />

        <Label layoutX="50.0"
               layoutY="120.0"
               text="Referencia de Pago:" />

        <TextField fx:id="txtReferencia"
                   layoutX="200.0"
                   layoutY="115.0"
                   prefWidth="200.0"
                   promptText="Ingrese referencia" />

        <Button layoutX="180.0"
                layoutY="250.0"
                prefWidth="120.0"
                text="Confirmar Pago"
                onAction="#confirmarPago"/>

    </children>

</AnchorPane>
