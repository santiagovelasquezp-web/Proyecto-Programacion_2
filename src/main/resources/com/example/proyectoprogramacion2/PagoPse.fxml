<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="450.0"
            prefWidth="550.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1">

    <children>

        <Label layoutX="170.0"
               layoutY="30.0"
               text="Pago PSE"
               style="-fx-font-size: 28px;
                      -fx-font-weight: bold;" />

        <Label layoutX="60.0"
               layoutY="120.0"
               text="Banco:" />

        <ComboBox layoutX="200.0"
                  layoutY="115.0"
                  prefWidth="220.0"
                  promptText="Seleccione banco" />

        <Label layoutX="60.0"
               layoutY="190.0"
               text="Documento:" />

        <TextField layoutX="200.0"
                   layoutY="185.0"
                   prefWidth="220.0"
                   promptText="Número documento" />

        <Button layoutX="200.0"
                layoutY="300.0"
                prefWidth="150.0"
                text="Continuar Pago" />

    </children>

</AnchorPane>
