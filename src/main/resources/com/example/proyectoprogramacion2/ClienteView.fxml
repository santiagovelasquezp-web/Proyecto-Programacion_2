<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.control.ScrollPane?>
<AnchorPane prefHeight="650.0"
            prefWidth="900.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.proyectoprogramacion2.Controllers.DashboardClienteController"
            style="-fx-background-color: #F4F6F9;">

    <children>

        <AnchorPane prefHeight="80.0"
                    prefWidth="900.0"
                    style="-fx-background-color: #1E293B;">

            <children>

                <Label layoutX="30.0"
                       layoutY="20.0"
                       text="Eventos Disponibles"
                       style="-fx-font-size: 30px;
                              -fx-font-weight: bold;
                              -fx-text-fill: white;" />

                <Button layoutX="740.0"
                        layoutY="18.0"
                        prefWidth="130.0"
                        prefHeight="40.0"
                        text="Cerrar Sesión"
                        onAction="#cerrarSesion"
                        style="-fx-background-color: #EF4444;
                               -fx-text-fill: white;
                               -fx-font-size: 14px;
                               -fx-font-weight: bold;
                               -fx-background-radius: 10;
                               -fx-cursor: hand;" />

            </children>

        </AnchorPane>

        <ScrollPane layoutX="25.0"
                    layoutY="100.0"
                    prefWidth="850.0"
                    prefHeight="520.0"
                    fitToWidth="true"
                    style="-fx-background: transparent;
                           -fx-background-color: transparent;">

            <content>

                <FlowPane fx:id="contenedorEventos"
                          prefWidth="800.0"
                          hgap="25.0"
                          vgap="25.0"
                          style="-fx-padding: 20;" />

            </content>

        </ScrollPane>

    </children>

</AnchorPane>
