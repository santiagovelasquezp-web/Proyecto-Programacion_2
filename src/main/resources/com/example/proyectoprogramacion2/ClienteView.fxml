<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="650.0"
            prefWidth="900.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.proyectoprogramacion2.Controllers.DashboardClienteController">

    <children>

        <Label layoutX="30.0"
               layoutY="20.0"
               text="Eventos Disponibles"
               style="-fx-font-size: 30px; -fx-font-weight: bold;" />

        <HBox layoutX="40.0"
              layoutY="100.0"
              spacing="40.0">

            <!-- CARD 1 -->

            <VBox spacing="10.0"
                  prefWidth="300.0"
                  style="-fx-background-color: #EFEFEF;
                         -fx-padding: 15;
                         -fx-background-radius: 10;">

                <ImageView fitHeight="150.0"
                           fitWidth="260.0" />

                <Label text="Concierto Rock"
                       style="-fx-font-size: 20px;
                              -fx-font-weight: bold;" />

                <Label text="Ciudad: Bogotá" />

                <Label text="Categoría: Rock" />

                <Button text="Ver Evento"
                        prefWidth="150.0"
                        onAction="#abrirCompraView"/>

            </VBox>

            <!-- CARD 2 -->

            <VBox spacing="10.0"
                  prefWidth="300.0"
                  style="-fx-background-color: #EFEFEF;
                         -fx-padding: 15;
                         -fx-background-radius: 10;">

                <ImageView fitHeight="150.0"
                           fitWidth="260.0" />

                <Label text="Festival Pop"
                       style="-fx-font-size: 20px;
                              -fx-font-weight: bold;" />

                <Label text="Ciudad: Medellín" />

                <Label text="Categoría: Pop" />

                <Button text="Ver Evento"
                        prefWidth="150.0"
                        onAction="#abrirCompraView"/>

            </VBox>

        </HBox>

    </children>

</AnchorPane>
