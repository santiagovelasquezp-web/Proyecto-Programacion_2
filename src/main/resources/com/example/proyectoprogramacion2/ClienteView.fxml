<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.layout.FlowPane?>
<AnchorPane prefHeight="650.0"
            prefWidth="900.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.proyectoprogramacion2.Controllers.DashboardClienteController">

    <children>

        <Label layoutX="30.0"
               layoutY="20.0"
               text="Eventos Disponibles"
               style="-fx-font-size: 30px; -fx-font-weight: bold;" />

        <FlowPane fx:id="contenedorEventos"
                  layoutX="40.0"
                  layoutY="100.0"
                  prefWidth="800.0"
                  hgap="30.0"
                  vgap="30.0"/>
        <Button layoutX="740.0"
                layoutY="20.0"
                prefWidth="120.0"
                text="Cerrar Sesión"
                onAction="#cerrarSesion"/>

    </children>

</AnchorPane>
