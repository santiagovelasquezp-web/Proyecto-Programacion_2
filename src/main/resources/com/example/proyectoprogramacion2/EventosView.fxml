<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="600.0"
            prefWidth="680.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.proyectoprogramacion2.Controllers.EventosController">

    <children>

        <Label layoutX="30.0"
               layoutY="20.0"
               text="Gestión de Eventos"
               style="-fx-font-size: 28px;
                      -fx-font-weight: bold;" />


        <TextField fx:id="txtNombre"
                   layoutX="30.0"
                   layoutY="90.0"
                   prefWidth="180.0"
                   promptText="Nombre Evento"/>

        <TextField fx:id="txtCiudad"
                   layoutX="230.0"
                   layoutY="90.0"
                   prefWidth="150.0"
                   promptText="Ciudad"/>

        <TextField fx:id="txtCategoria"
                   layoutX="400.0"
                   layoutY="90.0"
                   prefWidth="150.0"
                   promptText="Categoría"/>

        <TextArea fx:id="txtDescripcion"
                  layoutX="30.0"
                  layoutY="140.0"
                  prefWidth="300.0"
                  prefHeight="80.0"
                  promptText="Descripción"/>

        <DatePicker fx:id="dateFecha"
                    layoutX="350.0"
                    layoutY="140.0"
                    prefWidth="200.0"/>

        <Button layoutX="580.0"
                layoutY="90.0"
                text="Crear Evento"
                onAction="#crearEvento"/>

        <Button layoutX="580.0"
                layoutY="140.0"
                text="Eliminar"
                onAction="#eliminarEvento"/>


        <TableView fx:id="tablaEventos"
                   layoutX="30.0"
                   layoutY="260.0"
                   prefWidth="620.0"
                   prefHeight="300.0">

            <columns>

                <TableColumn fx:id="colId"
                             prefWidth="80.0"
                             text="ID"/>

                <TableColumn fx:id="colNombre"
                             prefWidth="160.0"
                             text="Nombre"/>

                <TableColumn fx:id="colCiudad"
                             prefWidth="120.0"
                             text="Ciudad"/>

                <TableColumn fx:id="colCategoria"
                             prefWidth="120.0"
                             text="Categoría"/>

                <TableColumn fx:id="colFecha"
                             prefWidth="120.0"
                             text="Fecha"/>

            </columns>

        </TableView>

    </children>

</AnchorPane>
