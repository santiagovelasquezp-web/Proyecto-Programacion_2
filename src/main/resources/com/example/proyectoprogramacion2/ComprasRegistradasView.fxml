<?xml version="1.0" encoding="UTF-8"?>

        <?import javafx.scene.control.*?>
        <?import javafx.scene.layout.*?>

<AnchorPane prefHeight="600.0"
            prefWidth="680.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.proyectoprogramacion2.Controllers.ComprasRegistradasController">

<children>

    <Label layoutX="30.0"
           layoutY="20.0"
           text="Compras Realizadas"
           style="-fx-font-size: 28px;
                      -fx-font-weight: bold;" />

    <TableView fx:id="tablaCompras"
               layoutX="30.0"
               layoutY="90.0"
               prefWidth="620.0"
               prefHeight="420.0">

        <columns>

            <TableColumn fx:id="colIdCompra"
                         prefWidth="100.0"
                         text="ID Compra"/>

            <TableColumn fx:id="colUsuario"
                         prefWidth="160.0"
                         text="Usuario"/>

            <TableColumn fx:id="colEvento"
                         prefWidth="180.0"
                         text="Evento"/>

            <TableColumn fx:id="colTotal"
                         prefWidth="120.0"
                         text="Total"/>

        </columns>

    </TableView>

</children>

</AnchorPane>