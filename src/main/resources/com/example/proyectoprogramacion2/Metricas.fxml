<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="600.0"
            prefWidth="680.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.proyectoprogramacion2.Controllers.MetricasController">

    <children>

        <Label layoutX="30.0"
               layoutY="20.0"
               text="Métricas del Sistema"
               style="-fx-font-size: 30px;
                      -fx-font-weight: bold;" />

        <PieChart fx:id="graficoCategorias"
                  layoutX="120.0"
                  layoutY="90.0"
                  prefHeight="400.0"
                  prefWidth="450.0"/>

    </children>

</AnchorPane>
